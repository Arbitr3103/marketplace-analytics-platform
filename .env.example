MAP_ENVIRONMENT=local
MAP_DEMO_MODE=true
MAP_DATABASE_URL=postgresql+asyncpg://analytics:analytics@postgres:5432/analytics
MAP_REDIS_URL=redis://redis:6379/0
MAP_CACHE_TTL_SECONDS=300
NEXT_PUBLIC_API_URL=http://localhost:8000

# Provider credentials belong in the private ingestion worker only.
# Never commit real values or expose them to the browser.
MARKETPLACE_CLIENT_ID=
MARKETPLACE_API_KEY=
